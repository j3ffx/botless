{
  "name": "botless-youtube",
  "version": "0.1.0",
  "private": true,
  "description": "Botless for YouTube — judges each channel as Probably Human / Probably AI / Inconclusive.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "icons": "node scripts/make-icons.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:commits": "node scripts/check-commits.mjs",
    "prepare": "node scripts/setup-hooks.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.300",
    "esbuild": "^0.25.0",
    "happy-dom": "^20.14.5",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
